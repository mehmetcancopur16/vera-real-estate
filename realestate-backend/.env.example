PORT=5050
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/vera_real_estate

# JWT_SECRET için güçlü, rastgele bir değer üretin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
JWT_SECRET=replace_with_64_char_random_hex
JWT_EXPIRES_IN=7d

# Production CORS: virgülle ayrılmış izinli frontend origin'leri
# CORS_ORIGINS=https://your-frontend.vercel.app
