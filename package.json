{
  "name": "vera-real-estate",
  "version": "1.0.0",
  "description": "Full-stack emlak ilan portalı (Next.js 15 + Express 5).",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev:backend": "npm run dev --prefix realestate-backend",
    "dev:frontend": "npm run dev --prefix realestate-frontend",
    "dev": "concurrently --kill-others-on-fail -c \"cyan.bold,magenta.bold\" -n \"BACKEND,FRONTEND\" --prefix \"[{name}]\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "install:all": "npm install && npm install --prefix realestate-backend && npm install --prefix realestate-frontend",
    "seed": "npm run seed --prefix realestate-backend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehmetcancopur16/vera-real-estate.git"
  },
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
